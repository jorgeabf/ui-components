---
interface Props {
  class?: string
}

const { class: className } = Astro.props
const currentPath = Astro.url.pathname

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/badges', label: 'Badges' },
  { href: '/buttons', label: 'Buttons' }
]
---

<nav class:list={['items-center gap-2 rounded-full border p-1', className]} style='border-color: var(--line); background: color-mix(in oklab, var(--surface) 92%, transparent);'>
  {links.map(({ href, label }) => (
    <a
      href={href}
      class:list={[
        'rounded-full px-3 py-2 text-sm font-semibold transition-all duration-200',
        currentPath === href
          ? 'text-white shadow-sm'
          : 'hover:-translate-y-0.5'
      ]}
      style={
        currentPath === href
          ? 'background: var(--accent); color: #fff;'
          : 'color: var(--text-muted);'
      }
    >
      {label}
    </a>
  ))}
</nav>
