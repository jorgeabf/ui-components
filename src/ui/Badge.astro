---
import type { HTMLAttributes } from 'astro/types'

type Color = 'gray' | 'red' | 'green' | 'blue' | 'yellow' | 'indigo' | 'purple' | 'pink'
type Size = 'sm' | 'md' | 'lg'
type Variant = 'soft' | 'solid' | 'outline'

interface Props extends HTMLAttributes<'span'> {
  color?: Color
  size?: Size
  variant?: Variant
  dot?: boolean
}

const {
  class: className,
  color = 'gray',
  size = 'md',
  variant = 'soft',
  dot = false,
  ...rest
} = Astro.props

const baseColors = {
  red: 'bg-red-500',
  green: 'bg-green-500',
  blue: 'bg-blue-500',
  yellow: 'bg-yellow-500',
  indigo: 'bg-indigo-500',
  purple: 'bg-purple-500',
  pink: 'bg-pink-500',
  gray: 'bg-gray-500'
}

const colors = {
  soft: {
    red: 'bg-red-50 text-red-700 ring-red-600/10 dark:bg-red-950 dark:text-red-300 dark:ring-red-300/20',
    green: 'bg-green-50 text-green-700 ring-green-600/10 dark:bg-green-950 dark:text-green-300 dark:ring-green-300/20',
    blue: 'bg-blue-50 text-blue-700 ring-blue-600/10 dark:bg-blue-950 dark:text-blue-300 dark:ring-blue-300/20',
    yellow: 'bg-yellow-50 text-yellow-800 ring-yellow-600/10 dark:bg-yellow-950 dark:text-yellow-300 dark:ring-yellow-300/20',
    indigo: 'bg-indigo-50 text-indigo-700 ring-indigo-600/10 dark:bg-indigo-950 dark:text-indigo-300 dark:ring-indigo-300/20',
    purple: 'bg-purple-50 text-purple-700 ring-purple-600/10 dark:bg-purple-950 dark:text-purple-300 dark:ring-purple-300/20',
    pink: 'bg-pink-50 text-pink-700 ring-pink-600/10 dark:bg-pink-950 dark:text-pink-300 dark:ring-pink-300/20',
    gray: 'bg-gray-50 text-gray-600 ring-gray-500/10 dark:bg-gray-800 dark:text-gray-300 dark:ring-gray-300/20'
  },
  solid: {
    red: 'bg-red-600 text-white',
    green: 'bg-green-700 text-white',
    blue: 'bg-blue-600 text-white',
    yellow: 'bg-yellow-500 text-yellow-950',
    indigo: 'bg-indigo-600 text-white',
    purple: 'bg-purple-600 text-white',
    pink: 'bg-pink-700 text-white',
    gray: 'bg-gray-600 text-white'
  },
  outline: {
    red: 'text-red-700 ring-red-600 dark:text-red-400 dark:ring-red-400',
    green: 'text-green-700 ring-green-600 dark:text-green-400 dark:ring-green-400',
    blue: 'text-blue-700 ring-blue-600 dark:text-blue-400 dark:ring-blue-400',
    yellow: 'text-yellow-800 ring-yellow-700 dark:text-yellow-400 dark:ring-yellow-400',
    indigo: 'text-indigo-700 ring-indigo-600 dark:text-indigo-400 dark:ring-indigo-400',
    purple: 'text-purple-700 ring-purple-600 dark:text-purple-400 dark:ring-purple-400',
    pink: 'text-pink-700 ring-pink-600 dark:text-pink-400 dark:ring-pink-400',
    gray: 'text-gray-700 ring-gray-600 dark:text-gray-400 dark:ring-gray-400'
  }
}

const sizes = {
  sm: 'px-2 py-1 text-xs',
  md: 'px-2.5 py-1 text-sm',
  lg: 'px-3 py-1.5 text-base'
}

const dotSizes = {
  sm: 'size-1.5',
  md: 'size-2',
  lg: 'size-2.5'
}
---

<span
  class:list={[
    'inline-flex items-center gap-x-1.5 rounded-full font-semibold leading-none',
    (variant === 'soft' || variant === 'outline') && 'ring-1 ring-inset',
    colors[variant][color],
    sizes[size],
    className
  ]}
  {...rest}
>
  {dot && (
    <span class:list={[
      'rounded-full',
      variant === 'solid' ? 'bg-white' : baseColors[color],
      dotSizes[size]
    ]} />
  )}
  <slot />
</span>
