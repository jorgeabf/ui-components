---
interface Props {
  href?: string
  class?: string
  theme?: 'primary' | 'secondary' | 'success' | 'danger' | 'warning' | 'info'
  variant?: 'solid' | 'outline' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  linkButton?: boolean
}

const {
  href,
  linkButton = false,
  type = 'button',
  theme = 'primary',
  variant = 'solid',
  size = 'md',
  class: className,
  ...rest
} = Astro.props

const colorMap = {
  solid: {
    primary: 'bg-orange-600 text-white hover:bg-orange-500 focus-visible:outline-orange-600',
    secondary: 'bg-stone-200 text-stone-800 hover:bg-stone-300 focus-visible:outline-stone-500 dark:bg-stone-700 dark:text-stone-100 dark:hover:bg-stone-600',
    success: 'bg-emerald-700 text-white hover:bg-emerald-600 focus-visible:outline-emerald-700',
    danger: 'bg-red-600 text-white hover:bg-red-500 focus-visible:outline-red-500',
    warning: 'bg-amber-500 text-amber-950 hover:bg-amber-400 focus-visible:outline-amber-700',
    info: 'bg-cyan-700 text-white hover:bg-cyan-600 focus-visible:outline-cyan-600',
  },
  outline: {
    primary: 'bg-transparent text-orange-700 ring-1 ring-inset ring-orange-600 hover:bg-orange-50 focus-visible:outline-orange-600 dark:text-orange-300 dark:ring-orange-400 dark:hover:bg-orange-950',
    secondary: 'bg-transparent text-stone-700 ring-1 ring-inset ring-stone-400 hover:bg-stone-100 focus-visible:outline-stone-500 dark:text-stone-300 dark:ring-stone-500 dark:hover:bg-stone-800',
    success: 'bg-transparent text-emerald-700 ring-1 ring-inset ring-emerald-700 hover:bg-emerald-50 focus-visible:outline-emerald-700 dark:text-emerald-400 dark:ring-emerald-400 dark:hover:bg-emerald-950',
    danger: 'bg-transparent text-red-600 ring-1 ring-inset ring-red-600 hover:bg-red-50 focus-visible:outline-red-500 dark:text-red-400 dark:ring-red-400 dark:hover:bg-red-950',
    warning: 'bg-transparent text-amber-800 ring-1 ring-inset ring-amber-700 hover:bg-amber-50 focus-visible:outline-amber-700 dark:text-amber-300 dark:ring-amber-400 dark:hover:bg-amber-950',
    info: 'bg-transparent text-cyan-700 ring-1 ring-inset ring-cyan-700 hover:bg-cyan-50 focus-visible:outline-cyan-600 dark:text-cyan-300 dark:ring-cyan-400 dark:hover:bg-cyan-950',
  },
  ghost: {
    primary: 'bg-transparent text-orange-700 hover:bg-orange-50 focus-visible:outline-orange-600 dark:text-orange-300 dark:hover:bg-orange-950',
    secondary: 'bg-transparent text-stone-700 hover:bg-stone-100 focus-visible:outline-stone-500 dark:text-stone-300 dark:hover:bg-stone-800',
    success: 'bg-transparent text-emerald-700 hover:bg-emerald-50 focus-visible:outline-emerald-700 dark:text-emerald-400 dark:hover:bg-emerald-950',
    danger: 'bg-transparent text-red-600 hover:bg-red-50 focus-visible:outline-red-500 dark:text-red-400 dark:hover:bg-red-950',
    warning: 'bg-transparent text-amber-800 hover:bg-amber-50 focus-visible:outline-amber-700 dark:text-amber-300 dark:hover:bg-amber-950',
    info: 'bg-transparent text-cyan-700 hover:bg-cyan-50 focus-visible:outline-cyan-600 dark:text-cyan-300 dark:hover:bg-cyan-950',
  },
}

const baseClasses =
  'inline-flex items-center gap-x-1.5 rounded-xl font-semibold transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2'

const shadowClass = variant === 'solid' ? 'shadow-sm' : ''

const sizes = {
  sm: 'text-sm px-2.5 py-1.5',
  md: 'text-base px-3 py-2',
  lg: 'text-lg px-4 py-2',
}
---

{
  linkButton ? (
    <a
      href={href}
      class:list={[
        baseClasses,
        shadowClass,
        colorMap[variant][theme],
        sizes[size],
        className,
        { 'opacity-50 cursor-not-allowed pointer-events-none': rest.disabled }
      ]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={[
        baseClasses,
        shadowClass,
        colorMap[variant][theme],
        sizes[size],
        className,
        { 'opacity-50 cursor-not-allowed': rest.disabled }
      ]}
      {...rest}
    >
      <slot />
    </button>
  )
}
