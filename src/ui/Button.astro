---
interface Props {
  href?: string
  class?: string
  theme?: 'primary' | 'secondary' | 'success' | 'danger' | 'warning' | 'info'
  variant?: 'solid' | 'outline' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  linkButton?: boolean
}

const {
  href,
  linkButton = false,
  type = 'button',
  theme = 'primary',
  variant = 'solid',
  size = 'md',
  class: className,
  ...rest
} = Astro.props

const colorMap = {
  solid: {
    primary: 'bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:outline-indigo-600',
    secondary: 'bg-gray-100 text-gray-800 hover:bg-gray-200 focus-visible:outline-gray-500 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600',
    success: 'bg-green-700 text-white hover:bg-green-600 focus-visible:outline-green-700',
    danger: 'bg-red-600 text-white hover:bg-red-500 focus-visible:outline-red-500',
    warning: 'bg-yellow-500 text-yellow-950 hover:bg-yellow-400 focus-visible:outline-yellow-700',
    info: 'bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-500',
  },
  outline: {
    primary: 'bg-transparent text-indigo-600 ring-1 ring-inset ring-indigo-600 hover:bg-indigo-50 focus-visible:outline-indigo-600 dark:text-indigo-400 dark:ring-indigo-400 dark:hover:bg-indigo-950',
    secondary: 'bg-transparent text-gray-600 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus-visible:outline-gray-500 dark:text-gray-300 dark:ring-gray-600 dark:hover:bg-gray-800',
    success: 'bg-transparent text-green-700 ring-1 ring-inset ring-green-700 hover:bg-green-50 focus-visible:outline-green-700 dark:text-green-400 dark:ring-green-400 dark:hover:bg-green-950',
    danger: 'bg-transparent text-red-600 ring-1 ring-inset ring-red-600 hover:bg-red-50 focus-visible:outline-red-500 dark:text-red-400 dark:ring-red-400 dark:hover:bg-red-950',
    warning: 'bg-transparent text-yellow-800 ring-1 ring-inset ring-yellow-700 hover:bg-yellow-50 focus-visible:outline-yellow-700 dark:text-yellow-400 dark:ring-yellow-400 dark:hover:bg-yellow-950',
    info: 'bg-transparent text-blue-600 ring-1 ring-inset ring-blue-600 hover:bg-blue-50 focus-visible:outline-blue-500 dark:text-blue-400 dark:ring-blue-400 dark:hover:bg-blue-950',
  },
  ghost: {
    primary: 'bg-transparent text-indigo-600 hover:bg-indigo-50 focus-visible:outline-indigo-600 dark:text-indigo-400 dark:hover:bg-indigo-950',
    secondary: 'bg-transparent text-gray-600 hover:bg-gray-100 focus-visible:outline-gray-500 dark:text-gray-300 dark:hover:bg-gray-800',
    success: 'bg-transparent text-green-700 hover:bg-green-50 focus-visible:outline-green-700 dark:text-green-400 dark:hover:bg-green-950',
    danger: 'bg-transparent text-red-600 hover:bg-red-50 focus-visible:outline-red-500 dark:text-red-400 dark:hover:bg-red-950',
    warning: 'bg-transparent text-yellow-800 hover:bg-yellow-50 focus-visible:outline-yellow-700 dark:text-yellow-400 dark:hover:bg-yellow-950',
    info: 'bg-transparent text-blue-600 hover:bg-blue-50 focus-visible:outline-blue-500 dark:text-blue-400 dark:hover:bg-blue-950',
  },
}

const baseClasses =
  'inline-flex items-center gap-x-1.5 rounded-md font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2'

const shadowClass = variant === 'solid' ? 'shadow-sm' : ''

const sizes = {
  sm: 'text-sm px-2.5 py-1.5',
  md: 'text-base px-3 py-2',
  lg: 'text-lg px-4 py-2',
}
---

{
  linkButton ? (
    <a
      href={href}
      class:list={[
        baseClasses,
        shadowClass,
        colorMap[variant][theme],
        sizes[size],
        className,
        { 'opacity-50 cursor-not-allowed pointer-events-none': rest.disabled }
      ]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={[
        baseClasses,
        shadowClass,
        colorMap[variant][theme],
        sizes[size],
        className,
        { 'opacity-50 cursor-not-allowed': rest.disabled }
      ]}
      {...rest}
    >
      <slot />
    </button>
  )
}
