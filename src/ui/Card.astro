---
interface Props {
  class?: string
  variant?: 'default' | 'bordered' | 'flat'
}

const { class: className, variant = 'default', ...rest } = Astro.props

const variants = {
  default: 'panel',
  bordered: 'panel ring-1 ring-inset',
  flat: 'rounded-2xl ring-1 ring-inset',
}
---

<div
  class:list={[
    'overflow-hidden rounded-2xl px-5 py-5 sm:px-6 sm:py-6 transition-transform duration-300 hover:-translate-y-1',
    variant === 'bordered' && 'ring-[var(--line)]',
    variant === 'flat' && 'bg-[var(--surface-strong)] ring-[var(--line)]',
    variants[variant],
    className
  ]}
  {...rest}
>
  <slot />
</div>
