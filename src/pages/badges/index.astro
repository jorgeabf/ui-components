---
import Layout from '../../layouts/Layout.astro'
import Container from '../../ui/Container.astro'
import Badge from '../../ui/Badge.astro'
---

<Layout title='Badge — Componentes Astro Tailwind'>
  <Container>
    <main class='py-12'>

      <header class='mb-10 pb-8 border-b border-gray-200 dark:border-gray-800'>
        <h1 class='text-3xl font-bold text-gray-900 dark:text-white mb-2'>Badge</h1>
        <p class='text-gray-500 dark:text-gray-400 max-w-2xl'>
          Etiquetas compactas para categorizar o indicar estado. Tres variantes
          (<code class='text-sm bg-gray-100 dark:bg-gray-800 dark:text-gray-300 px-1.5 py-0.5 rounded'>soft</code>,
          <code class='text-sm bg-gray-100 dark:bg-gray-800 dark:text-gray-300 px-1.5 py-0.5 rounded'>solid</code>,
          <code class='text-sm bg-gray-100 dark:bg-gray-800 dark:text-gray-300 px-1.5 py-0.5 rounded'>outline</code>),
          ocho colores y tres tamaños.
        </p>
      </header>

      <div class='space-y-10'>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap items-center gap-3'>
            <Badge size='sm'>Small</Badge>
            <Badge size='md'>Medium</Badge>
            <Badge size='lg'>Large</Badge>
          </div>
        </section>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>Variantes</h2>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap gap-3'>
            <Badge variant='soft' color='blue'>Soft</Badge>
            <Badge variant='solid' color='blue'>Solid</Badge>
            <Badge variant='outline' color='blue'>Outline</Badge>
          </div>
        </section>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>Colores — Soft</h2>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap gap-2'>
            <Badge color='gray'>Gray</Badge>
            <Badge color='red'>Red</Badge>
            <Badge color='green'>Green</Badge>
            <Badge color='blue'>Blue</Badge>
            <Badge color='yellow'>Yellow</Badge>
            <Badge color='indigo'>Indigo</Badge>
            <Badge color='purple'>Purple</Badge>
            <Badge color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>Colores — Solid</h2>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap gap-2'>
            <Badge variant='solid' color='gray'>Gray</Badge>
            <Badge variant='solid' color='red'>Red</Badge>
            <Badge variant='solid' color='green'>Green</Badge>
            <Badge variant='solid' color='blue'>Blue</Badge>
            <Badge variant='solid' color='yellow'>Yellow</Badge>
            <Badge variant='solid' color='indigo'>Indigo</Badge>
            <Badge variant='solid' color='purple'>Purple</Badge>
            <Badge variant='solid' color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>Colores — Outline</h2>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap gap-2'>
            <Badge variant='outline' color='gray'>Gray</Badge>
            <Badge variant='outline' color='red'>Red</Badge>
            <Badge variant='outline' color='green'>Green</Badge>
            <Badge variant='outline' color='blue'>Blue</Badge>
            <Badge variant='outline' color='yellow'>Yellow</Badge>
            <Badge variant='outline' color='indigo'>Indigo</Badge>
            <Badge variant='outline' color='purple'>Purple</Badge>
            <Badge variant='outline' color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3'>Con indicador (dot)</h2>
          <div class='p-6 bg-white dark:bg-gray-800 rounded-lg shadow flex flex-wrap gap-3'>
            <Badge dot color='green'>Online</Badge>
            <Badge dot color='red'>Offline</Badge>
            <Badge dot color='yellow'>Away</Badge>
            <Badge dot variant='solid' color='blue'>Active</Badge>
          </div>
        </section>

      </div>
    </main>
  </Container>
</Layout>
