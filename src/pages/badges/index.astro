---
import Layout from '../../layouts/Layout.astro'
import Container from '../../ui/Container.astro'
import Badge from '../../ui/Badge.astro'
---

<Layout title='Badge — Componentes Astro Tailwind'>
  <Container>
    <main class='py-12 sm:py-16'>
      <header class='mb-10 rounded-3xl border p-7 sm:p-9 animate-rise' style='border-color: var(--line); background: color-mix(in oklab, var(--surface) 88%, transparent);'>
        <p class='section-title mb-3'>Componente</p>
        <h1 class='brand-display mb-3 text-4xl font-bold sm:text-5xl' style='color: var(--text);'>Badge</h1>
        <p class='max-w-2xl text-base sm:text-lg' style='color: var(--text-muted);'>
          Etiquetas compactas para categorizar o indicar estado. Incluye variantes <code>soft</code>, <code>solid</code> y <code>outline</code> con ocho colores y tres tamanos.
        </p>
      </header>

      <div class='space-y-8 animate-rise animate-delay-1'>

        <section>
          <h2 class='section-title mb-3'>Tamanos</h2>
          <div class='panel flex flex-wrap items-center gap-3 p-6'>
            <Badge size='sm'>Small</Badge>
            <Badge size='md'>Medium</Badge>
            <Badge size='lg'>Large</Badge>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Variantes</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Badge variant='soft' color='blue'>Soft</Badge>
            <Badge variant='solid' color='blue'>Solid</Badge>
            <Badge variant='outline' color='blue'>Outline</Badge>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Colores - Soft</h2>
          <div class='panel flex flex-wrap gap-2 p-6'>
            <Badge color='gray'>Gray</Badge>
            <Badge color='red'>Red</Badge>
            <Badge color='green'>Green</Badge>
            <Badge color='blue'>Blue</Badge>
            <Badge color='yellow'>Yellow</Badge>
            <Badge color='indigo'>Indigo</Badge>
            <Badge color='purple'>Purple</Badge>
            <Badge color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Colores - Solid</h2>
          <div class='panel flex flex-wrap gap-2 p-6'>
            <Badge variant='solid' color='gray'>Gray</Badge>
            <Badge variant='solid' color='red'>Red</Badge>
            <Badge variant='solid' color='green'>Green</Badge>
            <Badge variant='solid' color='blue'>Blue</Badge>
            <Badge variant='solid' color='yellow'>Yellow</Badge>
            <Badge variant='solid' color='indigo'>Indigo</Badge>
            <Badge variant='solid' color='purple'>Purple</Badge>
            <Badge variant='solid' color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Colores - Outline</h2>
          <div class='panel flex flex-wrap gap-2 p-6'>
            <Badge variant='outline' color='gray'>Gray</Badge>
            <Badge variant='outline' color='red'>Red</Badge>
            <Badge variant='outline' color='green'>Green</Badge>
            <Badge variant='outline' color='blue'>Blue</Badge>
            <Badge variant='outline' color='yellow'>Yellow</Badge>
            <Badge variant='outline' color='indigo'>Indigo</Badge>
            <Badge variant='outline' color='purple'>Purple</Badge>
            <Badge variant='outline' color='pink'>Pink</Badge>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Con indicador (dot)</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Badge dot color='green'>Online</Badge>
            <Badge dot color='red'>Offline</Badge>
            <Badge dot color='yellow'>Away</Badge>
            <Badge dot variant='solid' color='blue'>Active</Badge>
          </div>
        </section>

      </div>
    </main>
  </Container>
</Layout>
