---
import Layout from '../../layouts/Layout.astro'
import Container from '../../ui/Container.astro'
import Button from '../../ui/Button.astro'
---

<Layout title='Button — Componentes Astro Tailwind'>
  <Container>
    <main class='py-12 sm:py-16'>
      <header class='mb-10 rounded-3xl border p-7 sm:p-9 animate-rise' style='border-color: var(--line); background: color-mix(in oklab, var(--surface) 88%, transparent);'>
        <p class='section-title mb-3'>Componente</p>
        <h1 class='brand-display mb-3 text-4xl font-bold sm:text-5xl' style='color: var(--text);'>Button</h1>
        <p class='max-w-2xl text-base sm:text-lg' style='color: var(--text-muted);'>
          Boton polimorfico que puede renderizar como <code>&lt;button&gt;</code> o <code>&lt;a&gt;</code>. Incluye seis temas, tres variantes visuales y tres tamanos.
        </p>
      </header>

      <div class='space-y-8 animate-rise animate-delay-1'>

        <section>
          <h2 class='section-title mb-3'>Temas - Solid</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Button theme='primary'>Primary</Button>
            <Button theme='secondary'>Secondary</Button>
            <Button theme='success'>Success</Button>
            <Button theme='danger'>Danger</Button>
            <Button theme='warning'>Warning</Button>
            <Button theme='info'>Info</Button>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Temas - Outline</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Button variant='outline' theme='primary'>Primary</Button>
            <Button variant='outline' theme='secondary'>Secondary</Button>
            <Button variant='outline' theme='success'>Success</Button>
            <Button variant='outline' theme='danger'>Danger</Button>
            <Button variant='outline' theme='warning'>Warning</Button>
            <Button variant='outline' theme='info'>Info</Button>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Temas - Ghost</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Button variant='ghost' theme='primary'>Primary</Button>
            <Button variant='ghost' theme='secondary'>Secondary</Button>
            <Button variant='ghost' theme='success'>Success</Button>
            <Button variant='ghost' theme='danger'>Danger</Button>
            <Button variant='ghost' theme='warning'>Warning</Button>
            <Button variant='ghost' theme='info'>Info</Button>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Tamanos</h2>
          <div class='panel flex flex-wrap items-center gap-3 p-6'>
            <Button size='sm'>Small</Button>
            <Button size='md'>Medium</Button>
            <Button size='lg'>Large</Button>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Estados</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Button>Normal</Button>
            <Button disabled>Disabled</Button>
          </div>
        </section>

        <section>
          <h2 class='section-title mb-3'>Link Button</h2>
          <div class='panel flex flex-wrap gap-3 p-6'>
            <Button linkButton href='/'>Ir a Inicio</Button>
            <Button linkButton href='/badges' theme='secondary'>Ir a Badges</Button>
            <Button linkButton href='/buttons' theme='info'>Ir a Buttons</Button>
          </div>
        </section>

      </div>
    </main>
  </Container>
</Layout>
