---
import Layout from '../layouts/Layout.astro'
import Container from '../ui/Container.astro'
import Card from '../ui/Card.astro'
import Button from '../ui/Button.astro'
import Badge from '../ui/Badge.astro'
import Modal from '../ui/Modal.astro'
---

<Layout title='Componentes Astro + Tailwind'>
  <Container>
    <main class='py-12 sm:py-16'>
      <section class='grid-ambient mb-12 rounded-3xl border p-8 sm:p-12 animate-rise' style='border-color: var(--line); background: color-mix(in oklab, var(--surface) 86%, transparent);'>
        <span class='mb-5 inline-flex rounded-full border px-4 py-1 text-[11px] font-bold uppercase tracking-[0.25em]' style='border-color: var(--line); color: var(--text-muted);'>
          Semilla UI · Astro Components
        </span>
        <h1 class='brand-display mb-4 max-w-3xl text-4xl font-bold sm:text-6xl' style='color: var(--text);'>
          Diseña interfaces con caracter, no plantillas genericas.
        </h1>
        <p class='mb-8 max-w-2xl text-base sm:text-lg' style='color: var(--text-muted);'>
          Coleccion de componentes pensada para equipos que quieren velocidad, consistencia visual y una direccion estetica reconocible.
        </p>
        <div class='flex flex-wrap gap-3'>
          <Button linkButton href='/buttons'>Ver Buttons</Button>
          <Button linkButton href='/badges' theme='secondary'>Ver Badges</Button>
          <Button linkButton href='/buttons' theme='info' variant='outline'>Explorar variantes</Button>
        </div>
      </section>

      <section class='mb-6 flex items-center justify-between gap-3 animate-rise animate-delay-1'>
        <h2 class='brand-display text-2xl font-semibold' style='color: var(--text);'>Componentes disponibles</h2>
        <Badge color='indigo' variant='outline'>En crecimiento</Badge>
      </section>

      <section class='grid gap-6 sm:grid-cols-2 lg:grid-cols-3 animate-rise animate-delay-2'>

        <a href='/buttons'>
          <Card class='h-full'>
            <div class='flex items-center justify-between mb-3'>
              <h2 class='text-lg font-semibold' style='color: var(--text);'>Button</h2>
              <Badge color='indigo' size='sm'>6 temas</Badge>
            </div>
            <p class='mb-5 text-sm' style='color: var(--text-muted);'>Sistema completo de botones con variantes solidas, outline, ghost y soporte nativo para enlaces.</p>
            <div class='flex flex-wrap gap-2'>
              <Button size='sm'>Primary</Button>
              <Button size='sm' theme='secondary'>Secondary</Button>
              <Button size='sm' theme='danger'>Danger</Button>
            </div>
          </Card>
        </a>

        <a href='/badges'>
          <Card class='h-full'>
            <div class='flex items-center justify-between mb-3'>
              <h2 class='text-lg font-semibold' style='color: var(--text);'>Badge</h2>
              <Badge color='blue' size='sm'>3 variantes</Badge>
            </div>
            <p class='mb-5 text-sm' style='color: var(--text-muted);'>Etiquetas flexibles para estados, categorias y metadatos de interfaz con dot indicator incluido.</p>
            <div class='flex flex-wrap gap-2'>
              <Badge color='blue'>Blue</Badge>
              <Badge variant='solid' color='green'>Online</Badge>
              <Badge variant='outline' color='purple'>Outline</Badge>
              <Badge dot color='yellow'>Away</Badge>
            </div>
          </Card>
        </a>

        <Card class='h-full'>
          <div class='flex items-center justify-between mb-3'>
            <h2 class='text-lg font-semibold' style='color: var(--text);'>Modal</h2>
            <Badge color='purple' size='sm'>Native dialog</Badge>
          </div>
          <p class='mb-5 text-sm' style='color: var(--text-muted);'>Componente accesible sobre <code>&lt;dialog&gt;</code> con backdrop blur, cierre por teclado y click fuera de caja.
          </p>
          <Modal buttonText='Abrir Modal' title='Ejemplo de Modal'>
            <p style='color: var(--text-muted);'>Este modal usa la API nativa del navegador para evitar hacks y mantener accesibilidad real.</p>
          </Modal>
        </Card>

      </section>
    </main>
  </Container>
</Layout>
